# ============================================================
# EcomKbAgent 后端环境变量样例
# 用法：复制为 .env 后按实际环境填写 —— cp .env.example .env
# 说明：
#   1. 本文件只含占位符，不含任何真实凭据，可安全提交到仓库；
#   2. .env 已被 .gitignore 排除，切勿将填写后的 .env 提交；
#   3. 分组与 README「4.4 配置环境变量」保持一致。
# ============================================================


# ------------------------------------------------------------
# 日志（对应 app/core/logger.py）
# ------------------------------------------------------------
# 控制台日志：开关 + 级别
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
# 文件日志：开关 + 级别（输出到 logs/app_YYYYMMDD.log）
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
# 文件日志保留时长（loguru retention 语法，如 "7 days" / "1 month"）
LOG_FILE_RETENTION=7 days


# ------------------------------------------------------------
# 文档解析（MinerU，对应 app/conf/mineru_config.py）
# ------------------------------------------------------------
MINERU_API_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINERU_BASE_URL=https://mineru.net/api/v4
# 由 MinerU / ModelScope 等第三方库隐式读取，用于离线部署
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=D:/pycharm/model
HF_HOME=D:/pycharm/model


# ------------------------------------------------------------
# LLM / VLM（对应 app/conf/lm_config.py）
# ------------------------------------------------------------
# OpenAI 兼容接口密钥；同一个 Key 同时用于百炼 MCP 鉴权
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 注意：必须是「兼容模式」地址，末尾带 /v1
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 文本生成模型（问题改写 / 商品名识别 / HyDE / 答案生成 / 图片摘要）
LLM_DEFAULT_MODEL=qwen3.7-flash
# 生成温度（0 最确定）
LLM_DEFAULT_TEMPERATURE=0.1
# 多模态模型（Markdown 图片上下文理解）
VL_MODEL=qwen3.7-max-2026-06-08


# ------------------------------------------------------------
# 百炼 WebSearch MCP（对应 app/conf/bailian_mcp_config.py）
# ------------------------------------------------------------
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp


# ------------------------------------------------------------
# MinIO 对象存储（对应 app/conf/minio_config.py）
# ------------------------------------------------------------
# 注意：不带 http:// 前缀（minio SDK 要求 host:port）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# 桶名，服务启动时自动创建并设置公开读策略
MINIO_BUCKET_NAME=knowledge-base-files
# 图片存储前缀（Markdown 图片上传后的对象路径前缀）
MINIO_IMG_DIR=/upload-images
# 是否启用 HTTPS
MINIO_SECURE=False


# ------------------------------------------------------------
# BGE-M3 混合向量模型（对应 app/conf/embedding_config.py）
# ------------------------------------------------------------
# 本地模型目录（ModelScope / HuggingFace 快照路径）
BGE_M3_PATH=D:/pycharm/model/BAAI--bge-m3/snapshots/master
# 模型仓库标识
BGE_M3=BAAI/bge-m3
# 推理设备：cuda:0 / cpu
BGE_DEVICE=cuda:0
# 是否半精度：1 / 0
BGE_FP16=1


# ------------------------------------------------------------
# BGE-Reranker-Large 重排模型（对应 app/conf/reranker_config.py）
# ------------------------------------------------------------
BGE_RERANKER_LARGE=D:/pycharm/model/BAAI--bge-reranker-large/snapshots/master
BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_FP16=1


# ------------------------------------------------------------
# Milvus 向量库（对应 app/conf/milvus_config.py）
# ------------------------------------------------------------
# 注意：必须带协议前缀 http://（pymilvus 3.x 会将纯 host:port 判为非法）
MILVUS_URL=http://127.0.0.1:19530
# 切片集合名（存放 text chunk 的稠密 + 稀疏向量）
CHUNKS_COLLECTION=kd_db_chunks
# 商品主体集合名（存放商品名向量，用于查询期商品匹配）
ITEM_NAME_COLLECTION=kd_db_item_names
# 以下为预留配置项，当前代码尚未读取（稠密向量维度在 node_import_milvus.py 中固定为 1024）
ENTITY_NAME_COLLECTION=kd_db_entity_names
EMBEDDING_DIM=1024
MILVUS_METRIC_TYPE=IP
MILVUS_MIN_COSINE_SCORE=0.5
# Milvus 鉴权（当前 docker-compose 未开启鉴权，暂未读取）
MILVUS_USER=
MILVUS_PASSWORD=


# ------------------------------------------------------------
# MongoDB 会话历史（对应 app/conf/mongo_config.py）
# ------------------------------------------------------------
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=knowledge_db_history


# ------------------------------------------------------------
# 启动期可选开关（对应 app/api/lifespan.py）
# ------------------------------------------------------------
# true 时在服务启动阶段预加载 Embedding / Reranker 本地模型；
# 默认 false，保持懒加载（首次查询时才加载，启动更快）
WARMUP_ENABLE=false


# ------------------------------------------------------------
# 遗留 / 预留项（当前代码未读取，按需保留或删除）
# ------------------------------------------------------------
# DASHROOT_DIR 等历史配置请勿自行新增；如需扩展请同步 README「4.4 配置环境变量」
MD_ROOT_DIR=D:/pycharm/PythonProject/EcomKbAgent/doc
