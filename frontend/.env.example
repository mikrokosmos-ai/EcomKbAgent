# 前端本地环境变量示例
# 运行时 API 前缀（对应 vite 代理）；生产环境可直接填绝对地址
VITE_IMPORT_API=/import-api
VITE_QUERY_API=/query-api

# 开发代理目标：后端「all」模式两个都填 8000；拆分模式 import=8000、query=8001
VITE_DEV_IMPORT_TARGET=http://127.0.0.1:8000
VITE_DEV_QUERY_TARGET=http://127.0.0.1:8000

# 导入侧端口：仅在生产态「同源配置」下用于 both 模式跨端口寻址 ——
# `python main.py --service both` 时 SPA 只挂在 query 侧(8001)，
# 前端会自动把 /upload、/status 指向同主机的该端口（默认 8000，与 main.py 一致）
# VITE_IMPORT_PORT=8000
