# ============================================================
# EcomKbAgent .gitignore
# 说明：以下条目对应的内容均【不需要】提交到 GitHub，
#       按类别分组，每组的注释说明了排除原因。
# ============================================================

# ---------- 敏感配置（含密钥，绝不提交） ----------
# .env 内含 API Token / MINIO / MILVUS / MONGO 等凭据
.env
.env.*
!.env.example

# ---------- Python 缓存与构建产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# ---------- 虚拟环境（3.6GB，本地安装依赖用） ----------
.venv/
venv/
env/

# ---------- IDE / 编辑器本地配置 ----------
# PyCharm 项目配置（含个人 workspace.xml 等）
.idea/
.vscode/
*.swp
*.swo

# ---------- 运行时产物（日志 / 输出 / 数据卷） ----------
# 运行日志
logs/
*.log
# 问答/识别输出结果
output/
# minio / milvus 挂载数据卷
volumes/

# ---------- 知识库语料 ----------
# doc/ 为厂商产品手册 PDF（约 85 个 / 404MB），体积大且涉及
# 厂商文档版权，不作为仓库内容；运行时按需放置于本地。
doc/

# ---------- 操作系统文件 ----------
Thumbs.db
Desktop.ini
.DS_Store
